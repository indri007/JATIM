      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      },
      "targets": [
        { "expr": "sum by (decision) (rate(batas_policy_decisions_total[5m]))", "legendFormat": "{{decision}}" }
      ]
    },
    {
      "id": 2,
      "title": "Prompt Injection Detected (5m Rate)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 5, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "sum(rate(batas_prompt_injection_detected_total[5m]))", "legendFormat": "Injections" }
      ]
    },
    {
      "id": 3,
      "title": "Prompt Injection Neutralized (5m Rate)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 5, "x": 13, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 0.01 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "sum(rate(batas_prompt_injection_neutralized_total[5m]))", "legendFormat": "Neutralized" }
      ]
    },
    {
      "id": 4,
      "title": "Token Violations: Expired & Replay (5m Rate)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "sum(rate(batas_token_violations_total{type=\"expired\"}[5m]))", "legendFormat": "Expired" },
        { "expr": "sum(rate(batas_token_violations_total{type=\"replay\"}[5m]))", "legendFormat": "Replay" }
