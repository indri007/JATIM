    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 200,
      "title": "Row 2: Risk Forensics & Top Deny Root Causes",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Top 5 Deny Reasons",
      "type": "barchart",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "topk(5, sum by (reason) (rate(batas_policy_decisions_total{decision=\"deny\"}[5m])))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Top 5 Risky Agent Actions",
      "type": "barchart",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "topk(5, sum by (agent_id, action) (rate(batas_agent_actions_total{risk=\"high\"}[5m])))",
          "legendFormat": "{{agent_id}} - {{action}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
