      "type": "logs",
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "{app=\"batas-opa\"} |= \"decision\" | json | decision=\"deny\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Live Agent Prompt Injection & Token Violation Logs",
      "type": "logs",
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "{app=\"batas-agent\"} |= \"prompt_injection\"",
          "refId": "A"
        },
        {
          "expr": "{app=\"batas-agent\"} |= \"token\" |= \"violation\"",
          "refId": "B"
        }
      ]
